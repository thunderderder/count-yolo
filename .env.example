# Optional. Copy to .env and edit. All values here are fake placeholders.

# auto | 0 | cpu
COUNT_YOLO_DEVICE=auto

# Optional Python executable override
COUNT_YOLO_PYTHON=C:\Python312\python.exe

# --- Input video / intersection config (new videos usually change these) ---
#
# Priority for video path:
#   1. CLI --video
#   2. COUNT_YOLO_VIDEO (this file)
#   3. "video_file" in the active config JSON
#   4. first *.mp4 in repo root (legacy fallback)
#
# Paths may be relative to the count_yolo repo root, or absolute.
#
# --- Default job (optional). When set, CLI can omit --job ---
# COUNT_YOLO_JOB=jobs/2026-文锦北路_南直行_0901.yaml

# Legacy single-video override (prefer job.video)
# COUNT_YOLO_VIDEO=videos/2026-文锦北路.MP4
#
# Legacy config override (prefer job.config)
# COUNT_YOLO_CONFIG=configs/文锦北路.json

# Optional second-model weights for motorcycle complement experiments
COUNT_YOLO_EBIKE_MODEL=models/electri_bike_and_vehicle.pt
